# Gemini API Key (Optional: without it, SkillPath operates in rich intelligent Demo Mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Optional: without it, SkillPath uses client persistence & demo state)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
